{
  "name": "omo-switcher",
  "version": "0.1.0",
  "private": true,
  "description": "切换 omo (oh-my-openagent) 与 omo-slim (oh-my-opencode-slim) 的性能/消耗配置，并一键重启 opencode",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "install:all": "npm install",
    "server": "npm --prefix server start",
    "dev:server": "npm --prefix server run dev",
    "client": "cd client && flutter run -d macos",
    "test:client": "cd client && flutter test",
    "test": "node --test tests/*.test.js",
    "installer:windows": "powershell -ExecutionPolicy Bypass -File scripts/build-installer-windows.ps1",
    "installer:macos": "bash scripts/build-installer-macos.sh"
  },
  "license": "MIT"
}
